<project>
<!-- This is a custom Freestyle job configuration parameterized for marker value and scheduled to run everyday at 10:20am -->
<actions/>
<description>all tests but with marker parameter and scheduled cron job</description>
<keepDependencies>false</keepDependencies>
<properties>
<hudson.model.ParametersDefinitionProperty>
<parameterDefinitions>
<hudson.model.ChoiceParameterDefinition>
<name>marker</name>
<choices class="java.util.Arrays$ArrayList">
<a class="string-array">
<string>smoke</string>
<string>regression</string>
<string>frameworktests</string>
<string>positive</string>
<string>negative</string>
</a>
</choices>
</hudson.model.ChoiceParameterDefinition>
</parameterDefinitions>
</hudson.model.ParametersDefinitionProperty>
</properties>
<scm class="hudson.scm.NullSCM"/>
<canRoam>true</canRoam>
<disabled>false</disabled>
<blockBuildWhenDownstreamBuilding>false</blockBuildWhenDownstreamBuilding>
<blockBuildWhenUpstreamBuilding>false</blockBuildWhenUpstreamBuilding>
<triggers>
<hudson.triggers.TimerTrigger>
<spec>20 10 * * *</spec>
</hudson.triggers.TimerTrigger>
</triggers>
<concurrentBuild>false</concurrentBuild>
<customWorkspace>C:\Users\vdevk\PycharmProjects\PythonPlaywright</customWorkspace>
<builders>
<hudson.tasks.Shell>
<command>pytest --tracing retain-on-failure -m "$marker" --html=reports/report.html --self-contained-html</command>
<configuredLocalRules/>
</hudson.tasks.Shell>
</builders>
<publishers/>
<buildWrappers/>
</project>